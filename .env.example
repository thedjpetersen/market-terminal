# The AI workspace uses the locally authenticated Codex app server by default.
# Run `codex login` and choose ChatGPT before launching the terminal.
MARKET_TERMINAL_AI_PROVIDER=codex
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECS=90

# Initial color preset. F3/Shift+F3 and THEME <name> change it at runtime;
# the last interactive selection is restored from local session state.
MARKET_TERMINAL_THEME=default

# Optional semantic shell/navigation remaps. Listed actions replace their
# defaults. Grammar: action=key,key;action=key. Esc, Ctrl+C, and Ctrl+B stay
# fixed; command-mode Vim/Emacs editing and tmux's post-prefix keys stay fixed.
MARKET_TERMINAL_KEYBINDINGS=

# Live RSS/Atom news. Defaults to CNBC Markets, SEC press releases, and Federal
# Reserve press releases. Supply comma-separated feed URLs to override.
MARKET_TERMINAL_NEWS_FEEDS=
MARKET_TERMINAL_NEWS_REFRESH_SECS=300
MARKET_TERMINAL_NEWS_TIMEOUT_SECS=12

# Live quotes, chart history, alerts, and spreadsheet financial functions.
# Yahoo's no-key, delayed, unofficial chart endpoint is the default. Select
# "finnhub", "alpha-vantage", or "alpaca" for documented official APIs.
MARKET_TERMINAL_MARKET_DATA_PROVIDER=yahoo
MARKET_TERMINAL_QUOTE_REFRESH_SECS=60
MARKET_TERMINAL_YAHOO_TIMEOUT_SECS=12
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1/
FINNHUB_TIMEOUT_SECS=12
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_TIMEOUT_SECS=12
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_DATA_URL=https://data.alpaca.markets/
ALPACA_TIMEOUT_SECS=12
MARKET_TERMINAL_WATCHLIST=AAPL,MSFT,NVDA
# Optional; Markets uses the watchlist when this is empty.
MARKET_TERMINAL_MARKETS_SYMBOLS=
MARKET_TERMINAL_CHART_SYMBOL=AAPL

# SEC EDGAR's live company master powers Find. SEC fair-access policy requires
# an identifiable application/contact user agent; override this for your fork.
MARKET_TERMINAL_SEC_USER_AGENT="market-terminal/0.1.0 your-email@example.com"
MARKET_TERMINAL_SEC_TIMEOUT_SECS=12
# Optional HTTPS endpoint overrides for compatible SEC mirrors/test systems.
MARKET_TERMINAL_SEC_DATA_BASE_URL=https://data.sec.gov/
MARKET_TERMINAL_SEC_ARCHIVES_BASE_URL=https://www.sec.gov/Archives/edgar/data/

# Optional broker positions export loaded at startup. Unlike currencies remain
# separate so the terminal never invents an FX rate or combined NAV.
MARKET_TERMINAL_PORTFOLIO_CSV=
# Optional cash-account or broker activity export. This has a separate durable
# import path and is never treated as sufficient input for performance returns.
MARKET_TERMINAL_PORTFOLIO_ACTIVITY_CSV=
# Optional dated valuation series for flow-adjusted TWR and benchmark returns.
MARKET_TERMINAL_PORTFOLIO_PERFORMANCE_CSV=
# Optional broker open-tax-lot export. Account identifiers are anonymized and
# unlike currencies remain separate.
MARKET_TERMINAL_PORTFOLIO_TAX_LOTS_CSV=
# Optional broker closed-lot export for exact realized-gain reconciliation.
MARKET_TERMINAL_PORTFOLIO_REALIZED_GAINS_CSV=
# Optional broker execution export for read-only order/fill reconciliation.
MARKET_TERMINAL_PORTFOLIO_TRADES_CSV=

# Optional API-key provider. Set MARKET_TERMINAL_AI_PROVIDER=openrouter to use it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional. Defaults to the platform state directory
# (~/.local/state/market-terminal on systems without XDG_STATE_HOME).
MARKET_TERMINAL_STATE_DIR=

# Optional live IRC chat. When IRC_SERVER is omitted, the interactive app keeps
# chat offline; deterministic gallery captures use a local demo feed.
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_TLS=true
IRC_NICKNAME=market-terminal
IRC_CHANNEL=#market-terminal
IRC_SERVER_PASSWORD=
IRC_NICKSERV_PASSWORD=
