# Required for the AI workspace. The application reads the process environment;
# it does not load this file automatically.
OPENROUTER_API_KEY=

# Optional. OpenRouter's task-aware auto router is the default.
OPENROUTER_MODEL=openrouter/auto

# Optional. Defaults to the platform state directory
# (~/.local/state/market-terminal on systems without XDG_STATE_HOME).
MARKET_TERMINAL_STATE_DIR=
