{
  "name": "market-terminal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "wasm-pack build ../crates/market-terminal-wasm --target web --out-dir ../../web/public/engine --out-name research_engine",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run tests/research.test.ts tests/auth.test.ts tests/modal.test.tsx",
    "preview": "wrangler dev --port 8799",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "format": "prettier --write src worker tests *.ts *.json *.jsonc",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lossless-json": "4.3.1",
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vitest": "latest",
    "wrangler": "4.129.0"
  }
}
