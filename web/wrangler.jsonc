{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market-terminal",
  "account_id": "0ca362fe4613d001393ddc3e59d57479",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "ACCESS_ISSUER": "https://frodojo.cloudflareaccess.com",
    "ACCESS_AUD": "1613ce6925ecf4298f40e8da58ceea1109fd579b6f8c3c73b00827d3e2f28f91",
    "ACCESS_EMAILS": "thedjpetersen@gmail.com",
    "ENGINE_CAPABILITIES": "run_backtest,compare_backtests,price_option,analyze_bond",
  },
  "ratelimits": [
    {
      "name": "ANALYTICS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [{ "pattern": "market.frodojo.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
